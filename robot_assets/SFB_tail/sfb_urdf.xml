  <equality>
  <joint joint1='alpha1' joint2='a3' polycoef='0 1 0 0 0'/>
  <joint joint1='alpha2' joint2='b3' polycoef='0 -1 0 0 0'/>
  <joint joint1='alpha1' joint2='m1' polycoef='0 -1 0 0 0'/>
  <joint joint1='alpha2' joint2='m2' polycoef='0 1 0 0 0'/>
  <connect body2="virtual_spring" body1="cart" anchor='0 0 0' active="true"/>
  <connect body2="virtual_spring" body1="cart" anchor='0 0 .1' />
  <connect body1="coupler2" body2="input2" anchor='-12.55 -13.37 44.90'/>
  <!-- <connect body1="coupler2" body2="input2" /> -->
  </equality>

   <actuator>
    <motor name="motor_left" joint="m1" />
    <motor name="motor_right" joint="m2" />
  </actuator>
  
  <sensor>
    <jointpos name="theta1_pos" joint="m1" noise="0"/>
    <jointpos name="theta2_pos" joint="m2" noise="0"/>

    <jointvel name="theta1_vel" joint="m1" noise="0"/>
    <jointvel name="theta2_vel" joint="m2" noise="0"/>

    <jointactuatorfrc name="theta1_torque" joint="m1" noise="0"/>
