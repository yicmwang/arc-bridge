<mujoco model="rsu_urdf">
  <compiler angle="radian" meshdir="meshes/"/>
  <option>
    <flag contact = 'disable'/>
  </option>

  <contact>
    <exclude body1 = 'world' body2 = 'left_mid' />
    <exclude body1 = 'world' body2 = 'right_mid'/>
    <exclude body1 = 'world' body2 = 'main_mid' />
    <exclude body1 = 'right_rod' body2 = 'motor_right' />
    <exclude body1 = 'left_rod' body2 = 'motor_left' />
    <exclude body1 = 'motor_right' body2 = 'main_mid' />
    <exclude body1 = 'motor_left' body2 = 'main_mid' />
    <exclude body1 = 'left_mid' body2 = 'left_rod' />
    <exclude body1 = 'right_mid' body2 = 'right_rod' />
    <exclude body1 = 'main_mid' body2 = 'main_rod' />
  </contact>



  <asset>
    <mesh name="base_link" content_type="model/stl" file="base_link.STL"/>
    <mesh name="left_mid" content_type="model/stl" file="left_mid.STL"/>
    <mesh name="left_rod" content_type="model/stl" file="left_rod.STL"/>
    <mesh name="right_mid" content_type="model/stl" file="right_mid.STL"/>
    <mesh name="right_rod" content_type="model/stl" file="right_rod.STL"/>
    <mesh name="main_mid" content_type="model/stl" file="main_mid.STL"/>
    <mesh name="main_rod" content_type="model/stl" file="main_rod.STL"/>
    <mesh name="motor_left" content_type="model/stl" file="motor_left.STL"/>
    <mesh name="motor_right" content_type="model/stl" file="motor_right.STL"/>
  </asset>
  <default>
    <site euler = '0 0 0' size = '0.00000000000001' />
    <motor ctrlrange="-30 30"/>
    <equality solref='0.005 1'/>
  </default>
  
  <actuator>
    <motor name="motor_left" joint="theta1" />
    <motor name="motor_right" joint="theta2" />
    <motor joint="psi1" />
    <motor joint="psi2" />
    <motor joint="phi1" />
    <motor joint="phi2" />
    <motor joint="alpha1" />
    <motor joint="alpha2" />
  </actuator>

  <sensor>
    <jointpos name="theta1_pos" joint="theta1" noise="0.01"/>
    <jointpos name="theta2_pos" joint="theta2" noise="0.01"/>
    <jointpos name="psi1_pos" joint="psi1" noise="0.01"/>
    <jointpos name="psi2_pos" joint="psi2" noise="0.01"/>
    <jointpos name="phi1_pos" joint="phi1" noise="0.01"/>
    <jointpos name="phi2_pos" joint="phi2" noise="0.01"/>
    <jointpos name="alpha1_pos" joint="alpha1" noise="0.01"/>
    <jointpos name="alpha2_pos" joint="alpha2" noise="0.01"/>

    <jointvel name="theta1_vel" joint="theta1" noise="0.01"/>
    <jointvel name="theta2_vel" joint="theta2" noise="0.01"/>
    <jointvel name="psi1_vel" joint="psi1" noise="0.01"/>
    <jointvel name="psi2_vel" joint="psi2" noise="0.01"/>
    <jointvel name="phi1_vel" joint="phi1" noise="0.01"/>
    <jointvel name="phi2_vel" joint="phi2" noise="0.01"/>
    <jointvel name="alpha1_vel" joint="alpha1" noise="0.01"/>
    <jointvel name="alpha2_vel" joint="alpha2" noise="0.01"/>

    <jointactuatorfrc name="theta1_torque" joint="theta1" noise="0.01"/>
    <jointactuatorfrc name="theta2_torque" joint="theta2" noise="0.01"/>
    <jointactuatorfrc name="psi1_torque" joint="psi1" noise="0.01"/>
    <jointactuatorfrc name="psi2_torque" joint="psi2" noise="0.01"/>
    <jointactuatorfrc name="phi1_torque" joint="phi1" noise="0.01"/>
    <jointactuatorfrc name="phi2_torque" joint="phi2" noise="0.01"/>
    <jointactuatorfrc name="alpha1_torque" joint="alpha1" noise="0.01"/>
    <jointactuatorfrc name="alpha2_torque" joint="alpha2" noise="0.01"/>
<!-- 
    <framequat name="imu_quat" objtype="site" objname="imu" noise="0.01"/>
    <gyro name="imu_gyro" site="imu" noise="0.01"/>
    <accelerometer name="imu_acc" site="imu" noise="0.01"/>

    <framepos name="frame_pos" objtype="site" objname="imu"/>
    <framelinvel name="frame_vel" objtype="site" objname="imu"/>

    <touch name="foot_force" site="foot_site"/> -->
